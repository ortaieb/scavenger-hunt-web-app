{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "rootDir": ".",
    // Lets tests import src/public/challenge-logic.js (plain JS, served
    // as-is to the browser, not compiled) and get its JSDoc-derived types.
    "allowJs": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"],
  // Tests that run a page's script in a DOM have the DOM's types, which
  // the server code mustn't: tsconfig.dom.json checks them.
  "exclude": ["tests/**/*.dom.test.ts"]
}
