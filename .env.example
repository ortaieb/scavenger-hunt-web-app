# Copy to .env to override locally (.env is gitignored and loaded automatically).

# Base URL of the separate game-server backend. POST /challenge relays
# captures to `${GAME_SERVER_URL}/challenge`.
GAME_SERVER_URL=http://localhost:8000

# How long (ms) POST /challenge waits for the game-server's referee before
# giving up and returning 504. Keep this comfortably above the game-server's
# own referee timeout plus its retries.
GAME_SERVER_TIMEOUT_MS=45000

# Clerk, which runs sign-up and sign-in. Both are public values, from the
# Clerk Dashboard (API keys). Leave them unset and the pages say sign-in isn't
# set up; the game works as it does without it.
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_FRONTEND_API=verb-noun-00.clerk.accounts.dev
